ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ai_dev_platform
REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

AI_PROVIDER=openrouter
AI_API_KEY=sk-or-v1-your-openrouter-key-here
AI_MODEL=cohere/north-mini-code:free
AI_AGENT_MAX_TOKENS=4096

STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=./storage_data

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

